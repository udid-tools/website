# Public deployment origin. Required in production and preview environments.
UDID_TOOLS_PUBLIC_ORIGIN=https://www.udid.tools

# signed is required in production; unsigned is accepted only for local development.
UDID_TOOLS_PROFILE_SIGNING_MODE=unsigned
UDID_TOOLS_PROFILE_SIGNING_PKCS12_BASE64=
UDID_TOOLS_PROFILE_SIGNING_PKCS12_PASSPHRASE=
UDID_TOOLS_PROFILE_SIGNING_CERTIFICATE_CHAIN_PEM=

# signature is the default. trust-chain additionally requires the trust anchors below.
UDID_TOOLS_PROFILE_RESPONSE_VERIFICATION_MODE=signature
UDID_TOOLS_PROFILE_RESPONSE_TRUST_ANCHORS_PEM=
UDID_TOOLS_PROFILE_RESPONSE_INTERMEDIATES_PEM=

# Generate with: openssl rand -base64 32
UDID_TOOLS_PROFILE_CHALLENGE_SECRET_BASE64=

# JSON keyring for permanent AES-256-GCM result links and the active key id.
# Example: {"2026-01":"<base64-encoded 32-byte key>"}
UDID_TOOLS_RESULT_TOKEN_KEYS=
UDID_TOOLS_RESULT_TOKEN_ACTIVE_KEY_ID=

# Optional privacy-filtered error and performance monitoring.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
