{
  "name": "@udid-tools/website",
  "version": "1.0.15",
  "private": true,
  "type": "module",
  "description": "Official UDID Tools website and free Safari-based UDID utility for iPhone and iPad.",
  "homepage": "https://www.udid.tools",
  "bugs": {
    "url": "https://github.com/udid-tools/website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udid-tools/website.git"
  },
  "author": {
    "name": "Alexander Tartmin",
    "url": "https://www.linkedin.com/in/alexandertartmin",
    "email": "hello@udid.tools"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "vitest run src/lib/__tests__/fuzz.test.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@sentry/nextjs": "10.76.2",
    "@udid-tools/core": "0.1.0-beta.11",
    "@udid-tools/device-info": "1.0.8",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "1.48.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.32.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-utils": "4.10.1",
    "@eslint/compat": "2.1.1",
    "@next/eslint-plugin-next": "14.2.35",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "eslint-config-next@16.4.2": {
      "@next/eslint-plugin-next": "14.2.35"
    },
    "glob@10.3.10": "10.5.0",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.12"
    },
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
