{
  "name": "@udid-tools/website",
  "version": "1.0.19",
  "private": true,
  "type": "module",
  "description": "Official UDID Tools website and free Safari-based UDID utility for iPhone and iPad.",
  "homepage": "https://www.udid.tools",
  "bugs": {
    "url": "https://github.com/udid-tools/website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udid-tools/website.git"
  },
  "author": {
    "name": "Alexander Tartmin",
    "url": "https://www.linkedin.com/in/alexandertartmin",
    "email": "hello@udid.tools"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "vitest run src/lib/__tests__/fuzz.test.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:npm-toolchain && npm run build",
    "test:npm-toolchain": "node --input-type=module --eval 'import { mkdirSync } from \"node:fs\"; mkdirSync(\"coverage\", { recursive: true });' && node --experimental-test-coverage --test-coverage-include=.github/scripts/install-npm.mjs --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/npm-toolchain.lcov --test .github/scripts/install-npm.node-test.mjs",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@sentry/nextjs": "10.76.2",
    "@udid-tools/core": "0.1.0-beta.13",
    "@udid-tools/device-info": "1.0.10",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "1.65.0",
    "motion": "14.8.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "16.36.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/eslint-utils": "4.10.1",
    "@eslint/compat": "2.1.1",
    "@next/eslint-plugin-next": "14.2.35",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      ".": "$@next/eslint-plugin-next",
      "glob": "14.0.3"
    },
    "@sentry/bundler-plugins@10.76.2": {
      "glob": "14.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
